# ==============================================================================
# ScrapeGuardian AI - Environment Variables Specification
# ==============================================================================
# In Google AI Studio, configure these API keys via the Settings/Secrets panel.
# All keys remain strictly on the server-side proxy routes and are never exposed to the client.

# 1. GOOGLE GEMINI API (Frontier Primary)
# Required for Gemini 2.5 Flash / 3.x Flash reasoning and DOM drift AST analysis.
GEMINI_API_KEY=""

# 2. GROQ API (High-Throughput LLaMA Inference)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=""

# 3. COHERE API (Enterprise Semantic & Command-R)
# Get your API key from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""

# 4. MISTRAL AI API (Specialized European Sovereign Models)
# Get your API key from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""

# 5. OPENROUTER API (Universal Unified Multi-Model Gateway)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# 6. BRIGHT DATA SERP DATASET INTEGRATION
# API Key obtained from Bright Data Control Panel (Bearer Token for Google SERP & Web Unlocker)
BRIGHT_DATA_API_KEY=""

# Bright Data Google SERP Dataset ID (e.g. gd_l1viktl72bvl7bjuj0 or custom SERP dataset ID)
BRIGHT_DATA_SERP_DATASET_ID="gd_l1viktl72bvl7bjuj0"

# APP_URL: The URL where this applet is hosted (injected automatically in Cloud Run)
APP_URL=""

